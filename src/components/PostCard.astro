---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { readingTime } from '../lib/reading-time';
import { formatDate } from '../lib/format-date';

type Props = {
  post: CollectionEntry<'posts'>;
  /** Stable sequence position for profile-based entry motion. */
  motionIndex?: number;
};

const { post, motionIndex = 0 } = Astro.props;
---

<article
  class="card card-lift group relative mb-6 break-inside-avoid p-6"
  data-reveal="card"
  style={`--motion-index: ${motionIndex}`}
>
  <a href={`/blog/${post.id}`} class="absolute inset-0" aria-label={post.data.title}></a>
  {post.data.cover && (
    <Image
      src={post.data.cover}
      alt=""
      widths={[400, 800]}
      sizes="(min-width: 1024px) 290px, (min-width: 768px) 45vw, 100vw"
      class="mb-5 h-auto w-full"
    />
  )}
  <h2 class="font-display font-semibold text-lg text-foreground mb-2 transition-colors group-hover:text-accent-text">
    {post.data.title}
  </h2>
  <p class="text-sm text-foreground-secondary mb-4">{post.data.description}</p>
  <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-foreground-tertiary">
    <span>
      {formatDate(post.data.pubDate)} · {readingTime(post.body ?? '')} min read
    </span>
    {post.data.tags[0] && <span class="topic">{post.data.tags[0]}</span>}
  </div>
</article>
