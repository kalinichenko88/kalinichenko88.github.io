---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { readingTime } from '../lib/reading-time';
import { formatDate } from '../lib/format-date';

type Props = {
  post: CollectionEntry<'posts'>;
  /** Title level: h2 on a page of posts, h3 inside a section with its own h2. */
  heading?: 'h2' | 'h3';
  /**
   * Reveal the card on its own. Off inside a sideways row, which reveals as one
   * block: a card clipped by the row would stay a blank peek at the edge.
   */
  reveal?: boolean;
  /** Stable sequence position for profile-based entry motion. */
  motionIndex?: number;
};

const { post, heading: Heading = 'h2', reveal = true, motionIndex = 0 } = Astro.props;
---

<article
  class="card card-lift group relative p-6"
  data-reveal={reveal ? 'card' : undefined}
  style={reveal ? `--motion-index: ${motionIndex}` : undefined}
>
  <a href={`/blog/${post.id}`} class="absolute inset-0" aria-label={post.data.title}></a>
  {post.data.cover && (
    <Image
      src={post.data.cover}
      alt=""
      widths={[400, 800]}
      sizes="(min-width: 1024px) 290px, (min-width: 768px) 45vw, 100vw"
      class="mb-5 h-auto w-full"
    />
  )}
  <Heading class="font-display font-semibold text-lg text-foreground mb-2 transition-colors group-hover:text-accent-text">
    {post.data.title}
  </Heading>
  <p class="text-sm text-foreground-secondary mb-4">{post.data.description}</p>
  <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-foreground-tertiary">
    <span>
      {formatDate(post.data.pubDate)} · {readingTime(post.body ?? '')} min read
    </span>
    {post.data.tags[0] && <span class="topic">{post.data.tags[0]}</span>}
  </div>
</article>
