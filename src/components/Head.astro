---
import { ClientRouter } from 'astro:transitions';

import { CONTACT_LINKS } from '../config/contacts';
import { AUTHOR_NAME, MAX_TITLE, SITE_NAME, SITE_TITLE } from '../consts';
import { siteImageAlt, siteImageSrc, toImageSite } from '../lib/site-image';

type Props = {
  /** The page's own title, without the site name. */
  title: string;
  description: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  tags?: string[];
  /** Social image: an absolute URL. Falls back to the site image. */
  image?: { src: string; alt: string };
};

const { title, description, type = 'website', publishedTime, tags, image } = Astro.props;

const site = toImageSite(CONTACT_LINKS);
const socialImage = image ?? {
  src: new URL(await siteImageSrc(site), Astro.url).href,
  alt: siteImageAlt(site),
};

// og:title stays bare, as Facebook asks. The tab and search title add the name
// only when the result still fits, so search results never cut it off.
const branded = `${title} - ${AUTHOR_NAME}`;
const nameFits = !title.includes(AUTHOR_NAME) && branded.length <= MAX_TITLE;
const documentTitle = nameFits ? branded : title;
---

<!-- Theme color -->
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f2ee" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1a1a1c" />

<!-- Favicons -->
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Canonical URL -->
<link rel="canonical" href={Astro.url.href} />

<!-- RSS Feed -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL('rss.xml', Astro.site)}
/>

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Primary Meta Tags -->
<title>{documentTitle}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage.src} />
<!-- Every social image is 1200x630, all rendered at build time.
     Facebook needs the size to show the image on the first share. -->
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={socialImage.alt} />
{type === 'article' && publishedTime && (
  <>
    <meta property="article:published_time" content={publishedTime} />
    <meta property="article:author" content={AUTHOR_NAME} />
    {tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </>
)}

<!-- X reads title, description and image from the og:* tags above, but not the alt -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image:alt" content={socialImage.alt} />
<meta name="twitter:site" content="@joker_bsg" />
<meta name="twitter:creator" content="@joker_bsg" />

<ClientRouter />
