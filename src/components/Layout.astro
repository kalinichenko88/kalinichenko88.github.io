---
import { Font } from 'astro:assets';

import Header from './Header.astro';
import PixelSpotlight from './PixelSpotlight.astro';
import Footer from './Footer.astro';
import Head from './Head.astro';
import MotionSwitcher from './MotionSwitcher.astro';

import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { LIGHT_THEME, DARK_THEME } from '../config/themes';
import { DEFAULT_MOTION_PROFILE, MOTION_OPTIONS, MOTION_STORAGE_KEY } from '../config/motion';

import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
  class?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  tags?: string[];
};

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  class: className,
  type,
  publishedTime,
  tags,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Theme initialization - must be first to prevent flash -->
    <script is:inline data-light={LIGHT_THEME} data-dark={DARK_THEME}>
      (function () {
        const { light, dark } = document.currentScript.dataset;

        function theme() {
          const pref = localStorage.getItem('theme');
          if (pref === light || pref === dark) return pref;
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? dark : light;
        }

        document.documentElement.setAttribute('data-theme', theme());

        // View Transitions: apply before swap to prevent a flash
        document.addEventListener('astro:before-swap', (e) => {
          e.newDocument.documentElement.setAttribute('data-theme', theme());
        });
      })();
    </script>
    <script
      is:inline
      data-motion-key={MOTION_STORAGE_KEY}
      data-motion-default={DEFAULT_MOTION_PROFILE}
      data-motion-values={MOTION_OPTIONS.map(({ id }) => id).join(',')}
    >
      (function () {
        const script = document.currentScript;
        const key = script.dataset.motionKey;
        const fallback = script.dataset.motionDefault;
        const values = script.dataset.motionValues.split(',');

        function motionProfile() {
          try {
            const stored = localStorage.getItem(key);
            return values.includes(stored) ? stored : fallback;
          } catch {
            return fallback;
          }
        }

        document.documentElement.dataset.motion = motionProfile();
        document.addEventListener('astro:before-swap', (event) => {
          event.newDocument.documentElement.dataset.motion = motionProfile();
        });
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Head
      title={title}
      description={description}
      type={type}
      publishedTime={publishedTime}
      tags={tags}
    />

    <!-- Fonts -->
    <Font cssVariable="--font-dm-sans" preload />
    <Font cssVariable="--font-jetbrains-mono" preload />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground antialiased">
    <!-- Scroll progress indicator: CSS scroll-driven, decorative (see global.css) -->
    <div class="scroll-progress" aria-hidden="true"></div>

    <PixelSpotlight />

    <Header />

    <main class:list={['flex-1', className]}>
      <slot />
    </main>

    <Footer />

    <MotionSwitcher />

    <!-- Cloudflare Web Analytics -->
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "d48eec331bac49d5afcfab679cc9d093"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </body>
</html>
