---
import { DARK_THEME, LIGHT_THEME } from '../../config/themes';
import { GISCUS_REPO, GISCUS_REPO_ID, GISCUS_CATEGORY, GISCUS_CATEGORY_ID } from '../../consts';

// An is:inline script cannot import, so it reads the theme ids from here.
const giscusConfig = JSON.stringify({
  repo: GISCUS_REPO,
  repoId: GISCUS_REPO_ID,
  category: GISCUS_CATEGORY,
  categoryId: GISCUS_CATEGORY_ID,
  themes: {
    [LIGHT_THEME]: 'light',
    [DARK_THEME]: 'transparent_dark',
  },
});
---

<section class="mt-12 pt-8 border-t border-line" data-reveal="content">
  <h2 class="text-xl font-display font-semibold text-foreground mb-6">Comments</h2>
  <div class="giscus"></div>
  <script is:inline data-giscus-config={giscusConfig}>
    (function () {
      const config = JSON.parse(document.currentScript.dataset.giscusConfig);

      function getGiscusTheme() {
        return config.themes[document.documentElement.getAttribute('data-theme')] || 'light';
      }

      function loadGiscus() {
        const container = document.querySelector('.giscus');
        // A box that holds client.js or its frame has giscus already: a navigation made
        // before the first page's window load gets astro:page-load twice.
        if (!container || container.childElementCount) {
          return;
        }

        const script = document.createElement('script');
        script.src = 'https://giscus.app/client.js';
        script.setAttribute('data-repo', config.repo);
        script.setAttribute('data-repo-id', config.repoId);
        script.setAttribute('data-category', config.category);
        script.setAttribute('data-category-id', config.categoryId);
        script.setAttribute('data-mapping', 'pathname');
        script.setAttribute('data-strict', '0');
        script.setAttribute('data-reactions-enabled', '1');
        script.setAttribute('data-emit-metadata', '0');
        script.setAttribute('data-input-position', 'top');
        script.setAttribute('data-theme', getGiscusTheme());
        script.setAttribute('data-lang', 'en');
        script.setAttribute('data-loading', 'lazy');
        script.crossOrigin = 'anonymous';
        script.async = true;
        container.appendChild(script);
      }

      // A theme switch keeps the frame, and the comment that the reader types in it.
      function setGiscusTheme() {
        const theme = getGiscusTheme();
        const script = document.querySelector('.giscus > script');
        const frame = document.querySelector('iframe.giscus-frame');
        if (script) {
          // client.js has not run yet: it reads the theme when it runs.
          script.setAttribute('data-theme', theme);
        } else if (frame?.classList.contains('giscus-frame--loading')) {
          // A lazy frame that has not loaded yet drops a message: it loads its URL.
          const url = new URL(frame.src);
          url.searchParams.set('theme', theme);
          frame.src = url.href;
        } else if (frame) {
          frame.contentWindow.postMessage(
            { giscus: { setConfig: { theme } } },
            'https://giscus.app'
          );
        }
        // With neither, the page has no comments, or giscus has not started: it starts in this theme.
      }

      // After a swap, giscus loads on astro:page-load, which fires after Astro runs the
      // new page's scripts. A client.js added before that, as on astro:after-swap,
      // would run a second time. Astro 7 runs this script once per visit; the guard
      // keeps one set of listeners if a router runs it again.
      if (!window.__giscusInitialized) {
        window.__giscusInitialized = true;
        window.addEventListener('theme-changed', setGiscusTheme);
        document.addEventListener('astro:page-load', loadGiscus);
      }

      // On a direct load, giscus starts while the page parses: the first astro:page-load
      // waits for the window load, so for every image.
      if (document.readyState === 'loading') {
        loadGiscus();
      }
    })();
  </script>
</section>
