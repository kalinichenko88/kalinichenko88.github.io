---
import EmailIcon from '../../assets/icons/email.svg';
import LinkedinIcon from '../../assets/icons/linkedin.svg';
import { MAIL_PROFILE_LINK, LINKEDIN_PROFILE_LINK } from '../../consts';
---

<section id="contact" class="py-14 md:py-20">
  <div class="container">
    <div class="max-w-prose reading-veil" data-reveal="content">
      <h2 class="text-foreground mb-4">Let's work together</h2>
      <p class="text-foreground-secondary mb-6">Interested in collaboration? Get in touch.</p>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
        <a href={`mailto:${MAIL_PROFILE_LINK}`} class="btn-primary">
          <EmailIcon class="w-4 h-4" />
          Send me an email
        </a>
        <a
          href={LINKEDIN_PROFILE_LINK}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary"
        >
          <LinkedinIcon class="w-4 h-4" />
          Connect on LinkedIn
        </a>
        <a href="/contact" class="link-underline text-sm sm:ml-2">
          More ways to reach me
        </a>
      </div>
    </div>
  </div>
</section>
