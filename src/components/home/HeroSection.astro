---
import { AUTHOR_NAME, ROLE, MAIL_PROFILE_LINK, GITHUB_PROFILE_LINK } from '../../consts';
---

<section class="hero" id="hero">
  <div class="container">
    <div class="intro">
      <h1 class="hero-name" data-reveal="hero" data-stagger-index="0">{AUTHOR_NAME}</h1>
      <p class="lead" data-reveal="hero" data-stagger-index="1">
        {ROLE} with 10+ years across React, TypeScript, and Node.js.
      </p>
      <p class="sub" data-reveal="hero" data-stagger-index="2">
        I build the frontend for a large self-hosted product, and spend the rest of my time on side
        projects, developer tools, and AI experiments. This is where I write about what I learn
        along the way.
      </p>
      <div class="actions" data-reveal="hero" data-stagger-index="3">
        <a href={`mailto:${MAIL_PROFILE_LINK}`} class="btn-primary">Get in touch</a>
        <a
          href={GITHUB_PROFILE_LINK}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary"
        >
          GitHub
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-8);
  }
  .intro {
    max-width: var(--container-prose);
  }
  .hero-name {
    font-size: clamp(2.5rem, 5.5vw, 3.6rem);
    margin-bottom: var(--space-4);
  }
  .lead {
    font-size: 1.28rem;
    line-height: 1.5;
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }
  .sub {
    font-size: 1.06rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }
</style>
