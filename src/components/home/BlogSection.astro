---
import type { CollectionEntry } from 'astro:content';
import CardRow from './CardRow.astro';
import PostCard from '../PostCard.astro';

type Props = {
  latestPosts: CollectionEntry<'posts'>[];
};

const { latestPosts } = Astro.props;
---

<section id="writing" class="py-14 md:py-20 bg-background-subtle/85">
  <CardRow
    title="Writing"
    href="/blog"
    linkLabel="Read all"
    prevLabel="Scroll to newer posts"
    nextLabel="Scroll to older posts"
  >
    {latestPosts.map((post) => (
      <PostCard post={post} heading="h3" row />
    ))}
  </CardRow>
</section>
