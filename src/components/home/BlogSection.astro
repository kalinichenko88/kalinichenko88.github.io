---
import type { CollectionEntry } from 'astro:content';
import PostCard from '../PostCard.astro';

import ArrowRightIcon from '../../assets/icons/arrow-right.svg';

type Props = {
  latestPosts: CollectionEntry<'posts'>[];
};

const { latestPosts } = Astro.props;
---

<section id="writing" class="py-14 md:py-20 bg-background-subtle/85">
  <div class="container">
    <div class="flex items-end justify-between gap-4 mb-8" data-reveal="heading">
      <h2 class="text-foreground">Writing</h2>
      <a href="/blog" class="link-underline text-sm inline-flex items-center gap-2">
        Read all
        <ArrowRightIcon class="w-4 h-4" />
      </a>
    </div>

    <!--
      One row of the same cards as /blog, scrolled sideways with native scroll
      snap. The cards are 18rem, so about three and a half show at the 1100px
      track and the clipped one says there is more. The row bleeds into the
      container padding so the card shadow and hover lift are not clipped. The
      row reveals as one block: a card revealed on its own would stay a blank
      peek at the clipped edge.
    -->
    <div
      data-reveal="content"
      class="-mx-4 flex snap-x snap-mandatory scroll-px-4 gap-6 overflow-x-auto px-4 pt-2 pb-6 [scrollbar-width:thin] *:w-72 *:shrink-0 *:snap-start"
    >
      {latestPosts.map((post) => (
        <PostCard post={post} heading="h3" row />
      ))}
    </div>
  </div>
</section>
