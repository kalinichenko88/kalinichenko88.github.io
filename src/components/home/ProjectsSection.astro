---
import CardRow from './CardRow.astro';
import ProjectCard from '../ProjectCard.astro';
import type { Project } from '../../lib/projects';

type Props = {
  projects: Project[];
};

const { projects } = Astro.props;
---

<section id="projects" class="py-14 md:py-20">
  <CardRow
    title="Selected work"
    href="/projects"
    linkLabel="All projects"
    prevLabel="Scroll to previous projects"
    nextLabel="Scroll to more projects"
  >
    {projects.map((project) => (
      <ProjectCard project={project} heading="h3" row />
    ))}
  </CardRow>
</section>
