---
// Site-wide cursor effect: a static dot lattice always visible, plus a warm
// accent glow quantized into pixels that follows the cursor. Rendered once by
// Layout.astro, so every page carries it. See DESIGN.md > Interaction.
---

<div class="pixel-fx" aria-hidden="true">
  <div class="fx-glow"></div>
</div>

<style>
  .pixel-fx {
    position: fixed;
    inset: 0;
    z-index: -1; /* above the body background, under every section */
    pointer-events: none;
    --cell: 12px;
    background-image: radial-gradient(circle at center, var(--color-line) 1.2px, transparent 1.2px);
    background-size: var(--cell) var(--cell);
  }

  .fx-glow {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.32s ease;
    background: radial-gradient(
      340px circle at var(--mx) var(--my),
      color-mix(in srgb, var(--color-accent) 18%, transparent),
      transparent 70%
    );
    /* Square lattice: two striped masks intersected. Tint and fill are held
       down for contrast, see DESIGN.md > Interaction before raising either. */
    --fill: calc(var(--cell) * 0.45);
    mask-image:
      repeating-linear-gradient(to right, #000 0 var(--fill), transparent var(--fill) var(--cell)),
      repeating-linear-gradient(to bottom, #000 0 var(--fill), transparent var(--fill) var(--cell));
    mask-composite: intersect;
  }
  :root[data-lit] .fx-glow {
    opacity: 1;
  }

  /* the lattice is static, so it stays; only the cursor glow is motion */
  @media (prefers-reduced-motion: reduce) {
    .fx-glow {
      display: none;
    }
  }
</style>

<script>
  // Written to <html>, not to the layer: custom properties inherit, and
  // ClientRouter replaces the layer on every swap while the root survives.
  // The glow sits behind the page, so over a text block it tints the very thing
  // being read. Light it only when the cursor is on bare background.
  const TEXT = 'p, h1, h2, h3, h4, h5, h6, li, a, button, code, pre, blockquote, figure, table';
  // The gap between two paragraphs is their margin, not background. Without
  // this the glow blinks on in every gap while reading down a page. Probing
  // only vertically: a paragraph's side margins are the gutter, and the glow
  // belongs there.
  // Stepped, not a single sample at PROBE: a prose h2 carries a 71px top
  // margin, so one probe at a fixed offset overshoots its box and lands in the
  // next gap, leaving the heading's own margin lit.
  const PROBE = 88;
  const STEP = 16;

  function textAt(cx: number, cy: number): Element | null {
    return document.elementFromPoint(cx, cy)?.closest(TEXT) ?? null;
  }

  function nearestText(cx: number, cy: number, dir: number): Element | null {
    for (let d = STEP; d <= PROBE; d += STEP) {
      const el = textAt(cx, cy + dir * d);
      if (el) return el;
    }
    return null;
  }

  function inMarginBox(el: Element, cy: number): boolean {
    const rect = el.getBoundingClientRect();
    const styles = getComputedStyle(el);
    return (
      cy >= rect.top - Number.parseFloat(styles.marginTop) &&
      cy <= rect.bottom + Number.parseFloat(styles.marginBottom)
    );
  }

  function overText(cx: number, cy: number): boolean {
    if (textAt(cx, cy)) return true;

    const above = nearestText(cx, cy, -1);
    const below = nearestText(cx, cy, 1);
    // Text on both sides means the cursor is inside a text flow, whatever the
    // gap: margins do not always tile it (a code block leaves a bare band).
    if (above && below) return true;
    // At the top or bottom edge of a block, only its own margin counts, so the
    // real background between sections stays lit.
    return (above != null && inMarginBox(above, cy)) || (below != null && inMarginBox(below, cy));
  }

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const root = document.documentElement;
    let raf = 0;
    let x = 0;
    let y = 0;

    addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType === 'touch') return;
        x = e.clientX;
        y = e.clientY;
        if (raf) return;
        raf = requestAnimationFrame(() => {
          root.style.setProperty('--mx', `${x}px`);
          root.style.setProperty('--my', `${y}px`);
          // Hit-tests and style reads run here, once per frame, not per move.
          if (overText(x, y)) delete root.dataset.lit;
          else root.dataset.lit = '';
          raf = 0;
        });
      },
      { passive: true }
    );

    document.addEventListener('pointerleave', () => delete root.dataset.lit);
  }
</script>
