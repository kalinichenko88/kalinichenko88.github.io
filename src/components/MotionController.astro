<script>
  import { initPage } from '../lib/motion-controller';

  declare global {
    interface Window {
      __motionStarted?: boolean;
    }
  }

  // A module script runs once, also across ClientRouter swaps. The flag tells
  // the failsafe in Layout.astro that the bundle loaded.
  window.__motionStarted = true;
  initPage();
  document.addEventListener('astro:after-swap', initPage);
</script>
