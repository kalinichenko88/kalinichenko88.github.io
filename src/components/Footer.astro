---
import { AUTHOR_NAME } from '../consts';
import { CONTACT_LINKS } from '../config/contacts';
import { NAV_LINKS } from '../config/navigation';

const currentYear = new Date().getFullYear();
---

<!-- opaque on purpose: it hides the pixel field, so the footer reads as a plain close to the page -->
<footer class="border-t border-line bg-background">
  <div class="container py-12 md:py-16">
    <!-- Main Footer Content -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-6">
      <!-- Brand Column -->
      <div class="md:col-span-4 space-y-3">
        <a
          href="/"
          class="inline-flex items-center font-display font-semibold text-foreground tracking-tight"
        >
          kalinichenko.dev
        </a>
        <p class="text-xs text-foreground-tertiary font-mono">
          {`© ${currentYear} ${AUTHOR_NAME}. Built with Astro.`}
        </p>
      </div>

      <!-- Navigation Column -->
      <div class="md:col-span-4">
        <h4 class="font-mono text-xs font-medium text-foreground-tertiary uppercase tracking-wider mb-4">
          Navigation
        </h4>
        <ul class="grid grid-cols-2 gap-x-6 gap-y-3">
          {NAV_LINKS.map((link) => {
            return (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-foreground-secondary hover:text-foreground transition-colors duration-150"
                >
                  {link.label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <!-- Connect Column -->
      <div class="md:col-span-4">
        <h4 class="font-mono text-xs font-medium text-foreground-tertiary uppercase tracking-wider mb-4">
          Connect
        </h4>
        <div class="flex flex-wrap gap-2">
          {CONTACT_LINKS.map((link) => {
            return (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="social-btn p-2.5 rounded-lg border border-line text-foreground-tertiary"
                aria-label={link.label}
              >
                <link.Icon class="w-4 h-4" />
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</footer>
