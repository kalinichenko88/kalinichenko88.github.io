---
import { THEME_OPTIONS } from '../../config/themes';

import CheckIcon from '../../assets/icons/check.svg';
import SunIcon from '../../assets/icons/sun.svg';
import MoonIcon from '../../assets/icons/moon.svg';
import MonitorIcon from '../../assets/icons/monitor.svg';

const themeIcons: Record<string, typeof SunIcon> = {
  sun: SunIcon,
  moon: MoonIcon,
  monitor: MonitorIcon,
};
---

<div id="theme-switcher" class="relative">
  <button
    id="theme-toggle"
    type="button"
    class="p-2 text-foreground-tertiary hover:text-foreground rounded-md transition-colors duration-150 cursor-pointer hover:bg-background-subtle"
    aria-label="Change theme"
    aria-expanded="false"
    aria-controls="theme-dropdown"
  >
    <MonitorIcon class="w-5 h-5 theme-icon" data-icon="monitor" />
    <SunIcon class="w-5 h-5 theme-icon hidden" data-icon="sun" />
    <MoonIcon class="w-5 h-5 theme-icon hidden" data-icon="moon" />
  </button>

  <!-- Theme Dropdown: a disclosure, so Tab moves through its options -->
  <div
    id="theme-dropdown"
    class="absolute right-0 top-full mt-2 w-40 py-1.5 bg-surface border border-line rounded-lg shadow-lg opacity-0 invisible translate-y-1 transition-all duration-150 z-50"
  >
    {THEME_OPTIONS.map((theme) => {
      const IconComponent = themeIcons[theme.iconId];

      return (
        <button
          type="button"
          class="theme-option w-full flex items-center gap-3 px-3 py-2 text-sm text-foreground-secondary hover:text-foreground hover:bg-background-subtle transition-colors cursor-pointer"
          data-theme={theme.id}
          aria-pressed="false"
        >
          <IconComponent class="w-4 h-4" />
          <span>{theme.label}</span>
          <CheckIcon class="theme-check w-4 h-4 ml-auto text-accent opacity-0" />
        </button>
      );
    })}
  </div>
</div>

<script>
  import { THEME_OPTIONS, resolveTheme } from '../../config/themes';

  const optionIds = THEME_OPTIONS.map((t) => {
    return t.id;
  });
  const iconById = Object.fromEntries(
    THEME_OPTIONS.map((t) => {
      return [t.id, t.iconId];
    })
  );

  function storedPreference(): string {
    const pref = localStorage.getItem('theme');

    return pref && optionIds.includes(pref) ? pref : 'auto';
  }

  function updateThemeUI(preference: string) {
    const iconId = iconById[preference];
    document.querySelectorAll('.theme-icon').forEach((icon) => {
      icon.classList.toggle('hidden', (icon as HTMLElement).dataset.icon !== iconId);
    });
    document.querySelectorAll<HTMLElement>('.theme-option').forEach((option) => {
      const selected = option.dataset.theme === preference;
      option.setAttribute('aria-pressed', String(selected));
      const check = option.querySelector<HTMLElement>('.theme-check');
      if (check) {
        check.style.opacity = selected ? '1' : '0';
      }
    });
  }

  function applyTheme(preference: string) {
    document.documentElement.setAttribute('data-theme', resolveTheme(preference));
    localStorage.setItem('theme', preference);
    updateThemeUI(preference);
    // Giscus (blog posts) re-renders itself on this
    window.dispatchEvent(new Event('theme-changed'));
  }

  function cycleTheme() {
    const next = (optionIds.indexOf(storedPreference()) + 1) % optionIds.length;
    applyTheme(optionIds[next]);
  }

  // Keep `auto` in sync when the OS preference flips
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (storedPreference() === 'auto') {
      applyTheme('auto');
    }
  });

  function toggleDropdown(show: boolean, returnFocus = true) {
    const dropdown = document.getElementById('theme-dropdown');
    const toggle = document.getElementById('theme-toggle');
    if (!dropdown || !toggle) {
      return;
    }

    dropdown.classList.toggle('opacity-0', !show);
    dropdown.classList.toggle('invisible', !show);
    dropdown.classList.toggle('translate-y-1', !show);
    toggle.setAttribute('aria-expanded', String(show));

    // Hiding the dropdown hides its focused option too: give focus back to the button
    if (!show && returnFocus && dropdown.contains(document.activeElement)) {
      toggle.focus();
    }
  }

  // Tab out of the switcher closes the dropdown and leaves focus where Tab put it.
  // Focus that goes to no element, as to another window, keeps it open.
  document.addEventListener('focusout', (e) => {
    const switcher = (e.target as HTMLElement).closest('#theme-switcher');
    const next = e.relatedTarget as Node | null;
    if (switcher && next && !switcher.contains(next)) {
      toggleDropdown(false, false);
    }
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    const toggle = target.closest('#theme-toggle');
    if (toggle) {
      e.preventDefault();
      toggleDropdown(toggle.getAttribute('aria-expanded') !== 'true');

      return;
    }

    const option = target.closest<HTMLElement>('.theme-option');
    if (option?.dataset.theme) {
      applyTheme(option.dataset.theme);
      toggleDropdown(false);

      return;
    }

    if (!target.closest('#theme-dropdown')) {
      toggleDropdown(false);
    }
  });

  document.addEventListener('keydown', (e) => {
    // Cmd/Ctrl + / cycles Auto -> Light -> Dark
    if ((e.metaKey || e.ctrlKey) && e.key === '/') {
      e.preventDefault();
      cycleTheme();

      return;
    }

    if (e.key === 'Escape') {
      toggleDropdown(false);
    }
  });

  function init() {
    updateThemeUI(storedPreference());
    toggleDropdown(false);
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
