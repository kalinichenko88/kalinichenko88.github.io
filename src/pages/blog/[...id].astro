---
import { render } from 'astro:content';

import Layout from '../../components/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Comments from '../../components/blog/Comments.astro';
import PostHeader from '../../components/blog/PostHeader.astro';
import { getPosts } from '../../lib/posts/posts';
import { postImageSrc, toImagePost } from '../../lib/posts/post-image';

import ArrowLeftIcon from '../../assets/icons/arrow-left.svg';
import TwitterIcon from '../../assets/icons/twitter.svg';
import LinkedInIcon from '../../assets/icons/linkedin.svg';

import { AUTHOR_NAME } from '../../consts';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => {
    return {
      params: { id: post.id },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((h) => {
  return h.depth >= 2 && h.depth <= 3;
});

// Rendered by ./[id].png.ts from the frontmatter and the cover, so it always
// carries the current title and description.
const imagePost = toImagePost(post);
const socialImage = imagePost && {
  src: new URL(await postImageSrc(post.id, imagePost), Astro.url).href,
  alt: `${post.data.title}. ${post.data.description}`,
};

const blogPostSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  author: {
    '@type': 'Person',
    name: AUTHOR_NAME,
    url: Astro.site!.href,
  },
  publisher: {
    '@type': 'Person',
    name: AUTHOR_NAME,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': Astro.url.href,
  },
  keywords: post.data.tags.join(', '),
  ...(socialImage && { image: socialImage.src }),
};
---

<Layout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  tags={post.data.tags}
  image={socialImage}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(blogPostSchema)} />
  <article class="py-12 md:py-16">
    <div class="container">
      <PostHeader post={post} />

      <div class="reading-veil">
        {tocHeadings.length > 0 && (
          <div class="mb-10">
            <TableOfContents headings={headings} />
          </div>
        )}

        <div class="prose prose-custom max-w-none">
          <Content />
        </div>
      </div>

      <Comments />

      <!-- Article Footer -->
      <footer class="mt-10 pt-6 border-t border-line" data-reveal="content">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 text-sm font-medium text-foreground-secondary hover:text-foreground transition-colors"
          >
            <ArrowLeftIcon class="w-4 h-4" />
            All posts
          </a>

          <div class="flex items-center gap-4">
            <span class="text-sm text-foreground-tertiary">Share:</span>
            <a
              href={`https://x.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(Astro.url.href)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 text-foreground-tertiary hover:text-foreground transition-colors"
              aria-label="Share on Twitter"
            >
              <TwitterIcon class="w-4 h-4" />
            </a>
            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 text-foreground-tertiary hover:text-foreground transition-colors"
              aria-label="Share on LinkedIn"
            >
              <LinkedInIcon class="w-4 h-4" />
            </a>
          </div>
        </div>
      </footer>
    </div>
  </article>

  <script>
    let headingObserverRef: IntersectionObserver | null = null;

    function initTocObserver() {
      // Disconnect previous observer to prevent leaks across View Transitions
      headingObserverRef?.disconnect();
      headingObserverRef = null;

      // Highlight the inline TOC link for the heading currently in view.
      const tocLinks = document.querySelectorAll('.toc-link');
      const headings = Array.from(
        document.querySelectorAll('.prose h2[id], .prose h3[id]')
      ) as HTMLElement[];
      if (!headings.length) {
        return;
      }

      let currentActiveId = '';
      headingObserverRef = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              currentActiveId = entry.target.id;
            }
          }
          tocLinks.forEach((link) => {
            link.classList.toggle('active', link.getAttribute('href') === `#${currentActiveId}`);
          });
        },
        { rootMargin: '0px 0px -70% 0px', threshold: 0 }
      );

      headings.forEach((h) => {
        headingObserverRef!.observe(h);
      });
    }

    initTocObserver();
    document.addEventListener('astro:after-swap', initTocObserver);
  </script>
</Layout>
