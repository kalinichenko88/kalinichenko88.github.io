---
import { getCollection } from 'astro:content';

import Layout from '../../components/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import RssIcon from '../../assets/icons/rss.svg';

const allPosts = await getCollection('posts');
const posts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const [lead, ...rest] = posts;
---

<Layout
  title="Blog"
  description="AI experiments, dev tools, frontend architecture, and things I'm figuring out along the way."
>
  <section class="py-14 md:py-20">
    <div class="container">
      <div class="flex items-center gap-3 mb-3" data-reveal="heading">
        <h1 class="text-foreground">Writing</h1>
        <a
          href="/rss.xml"
          class="p-2 text-foreground-tertiary hover:text-accent transition-colors"
          aria-label="RSS Feed"
          title="Subscribe via RSS"
        >
          <RssIcon class="w-5 h-5" />
        </a>
      </div>
      <p class="text-foreground-secondary mb-10 max-w-prose" data-reveal="content">
        AI experiments, dev tools, frontend architecture, and things I'm figuring out along the way.
      </p>

      {
        posts.length > 0 ? (
          <div class="grid gap-6 md:grid-cols-2">
            {lead && <PostCard post={lead} featured motionIndex={1} />}
            {rest.map((post, index) => (
              <PostCard post={post} motionIndex={index + 2} />
            ))}
          </div>
        ) : (
          <p class="text-foreground-secondary">Articles coming soon.</p>
        )
      }
    </div>
  </section>
</Layout>
