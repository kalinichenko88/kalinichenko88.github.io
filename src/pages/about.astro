---
import Layout from '../components/Layout.astro';

import { ROLE, MAIL_PROFILE_LINK, LINKEDIN_PROFILE_LINK } from '../consts';
import { WORK_HISTORY, EXPERTISE, LOCATION } from '../config/resume';
---

<Layout title="About" description="About Ivan Kalinichenko - Senior Frontend Engineer.">
  <section class="py-14 md:py-20">
    <div class="container-prose">
      <div class="reading-veil">
        <h1 class="text-foreground mb-6" data-reveal="heading">
          About
        </h1>
        <div
          class="space-y-4 text-foreground-secondary text-lg leading-relaxed"
          data-reveal="content"
        >
          <p>
            I'm a {ROLE.toLowerCase()} with 10+ years in the industry, from jQuery and Angular.js to
            modern component architectures. That path shaped how I think about maintainable systems
            and team productivity.
          </p>
          <p>
            Today I build the frontend for a large-scale self-hosted product with React and
            TypeScript. Beyond writing code, I review merge requests, mentor frontend developers,
            run technical interviews, and onboard new engineers. I use AI tools as part of the daily
            workflow.
          </p>
          <p>
            Based in <span class="text-foreground">{LOCATION}</span>, working with international
            remote teams.
          </p>
        </div>

        <div
          class="flex flex-wrap items-center gap-3 mt-8"
          data-reveal="content"
          style="--motion-index: 1"
        >
          <a href={`mailto:${MAIL_PROFILE_LINK}`} class="btn-primary">
            Get in touch
          </a>
          <a
            href={LINKEDIN_PROFILE_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
          >
            Connect on LinkedIn
          </a>
          <a href="/contact" class="link-underline text-sm">
            More ways to reach me
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20 bg-background-subtle/85">
    <div class="container">
      <h2 class="text-foreground mb-8" data-reveal="heading">
        Expertise
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {EXPERTISE.map((area, index) => {
          return (
            <div
              class="card card-hover p-5"
              data-reveal="card"
              style={`--motion-index: ${index + 1}`}
            >
              <h3 class="font-display font-semibold text-foreground mb-4">{area.category}</h3>
              <div class="flex flex-wrap gap-2">
                {area.skills.map((skill) => {
                  return <span class="tag">{skill}</span>;
                })}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20">
    <div class="container-prose">
      <div class="reading-veil">
        <h2 class="text-foreground mb-8" data-reveal="heading">
          Work history
        </h2>
        <div class="space-y-6">
          {WORK_HISTORY.map((job, index) => {
            return (
              <div
                class="flex items-baseline justify-between gap-4 border-b border-line pb-4"
                data-reveal="card"
                style={`--motion-index: ${index + 1}`}
              >
                <div>
                  <div class="font-medium text-foreground">{job.company}</div>
                  <div class="text-sm text-foreground-secondary">{job.title}</div>
                </div>
                <span class="font-mono text-xs text-foreground-tertiary shrink-0">
                  {job.period}
                </span>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>
</Layout>
