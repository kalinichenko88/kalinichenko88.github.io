---
import { getCollection } from 'astro:content';

import Layout from '../components/Layout.astro';
import ExternalLinkIcon from '../assets/icons/external-link.svg';
import { getProjects } from '../lib/projects';
import { formatDate } from '../lib/format-date';
import { GITHUB_PROFILE_LINK } from '../consts';

const projects = await getProjects();
const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<Layout
  title="Projects"
  description="Open-source tools I build and maintain, next to what I've written on the same topics."
>
  <section class="py-14 md:py-20">
    <div class="container">
      <div
        class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-3"
        data-reveal="heading"
      >
        <h1 class="text-foreground">Projects</h1>
        <a
          href={GITHUB_PROFILE_LINK}
          target="_blank"
          rel="noopener noreferrer"
          class="link-underline text-sm inline-flex items-center gap-2"
        >
          View GitHub profile
          <ExternalLinkIcon class="w-4 h-4" />
        </a>
      </div>
      <p class="text-foreground-secondary mb-10 max-w-prose" data-reveal="content">
        Open-source tools I build and maintain, next to what I've written on the same topics.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {projects.map((project, index) => {
          const related = posts.filter((post) =>
            post.data.tags.some((tag) => project.tags.includes(tag))
          );
          return (
            <article
              class="card p-6 flex flex-col"
              data-reveal="card"
              style={`--motion-index: ${index + 1}`}
            >
              <h2 class="font-display font-semibold text-xl text-foreground mb-2">
                {project.name}
              </h2>
              <p class="text-foreground-secondary mb-4">{project.tagline}</p>
              <div class="flex flex-wrap gap-2 mb-5">
                {project.tech.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
              <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
                {project.homepage && (
                  <a
                    href={project.homepage}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-underline inline-flex items-center gap-2"
                  >
                    Website
                    <ExternalLinkIcon class="w-4 h-4" />
                  </a>
                )}
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-underline inline-flex items-center gap-2"
                >
                  Repository
                  <ExternalLinkIcon class="w-4 h-4" />
                </a>
                {project.stars > 0 && (
                  <span class="font-mono text-xs text-foreground-tertiary">
                    {project.stars} {project.stars === 1 ? 'star' : 'stars'}
                  </span>
                )}
              </div>

              {related.length > 0 && (
                <div class="mt-6 pt-5 border-t border-line">
                  <div class="flex flex-wrap items-center gap-2 mb-3">
                    <h3 class="text-sm font-semibold text-foreground mr-1">Related posts</h3>
                    {project.tags.map((tag) => (
                      <a href={`/tags/${tag}`} class="tag">
                        {tag}
                      </a>
                    ))}
                  </div>
                  <ul class="space-y-2">
                    {related.map((post) => (
                      <li class="flex items-baseline justify-between gap-4">
                        <a href={`/blog/${post.id}`} class="link-underline text-sm">
                          {post.data.title}
                        </a>
                        <time
                          datetime={post.data.pubDate.toISOString()}
                          class="font-mono text-xs text-foreground-tertiary shrink-0"
                        >
                          {formatDate(post.data.pubDate)}
                        </time>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
