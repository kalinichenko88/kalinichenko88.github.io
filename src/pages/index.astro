---
import Layout from '../components/Layout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import CardRow from '../components/home/CardRow.astro';
import ContactSection from '../components/home/ContactSection.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPosts } from '../lib/posts';
import { getProjects } from '../lib/projects';

import {
  AUTHOR_NAME,
  ROLE,
  GITHUB_PROFILE_LINK,
  LINKEDIN_PROFILE_LINK,
  TWITTER_PROFILE_LINK,
} from '../consts';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTHOR_NAME,
  jobTitle: ROLE,
  url: Astro.site!.href,
  sameAs: [GITHUB_PROFILE_LINK, LINKEDIN_PROFILE_LINK, TWITTER_PROFILE_LINK],
  knowsAbout: ['React', 'TypeScript', 'JavaScript', 'Frontend Architecture', 'Web Performance'],
};

const latestPosts = (await getPosts()).slice(0, 8);

const projects = await getProjects();
---

<Layout>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
  <HeroSection />
  <section id="projects" class="py-14 md:py-20">
    <CardRow
      title="Selected work"
      href="/projects"
      linkLabel="All projects"
      prevLabel="Scroll to previous projects"
      nextLabel="Scroll to more projects"
    >
      {projects.map((project) => {
        return <ProjectCard project={project} heading="h3" row />;
      })}
    </CardRow>
  </section>
  {latestPosts.length > 0 && (
    <section id="writing" class="py-14 md:py-20 bg-background-subtle/85">
      <CardRow
        title="Writing"
        href="/blog"
        linkLabel="Read all"
        prevLabel="Scroll to newer posts"
        nextLabel="Scroll to older posts"
      >
        {latestPosts.map((post) => {
          return <PostCard post={post} heading="h3" row />;
        })}
      </CardRow>
    </section>
  )}
  <ContactSection />
</Layout>
