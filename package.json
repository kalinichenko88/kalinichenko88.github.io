{
  "name": "kalinichenko88.github.io",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run check && npm run format:check && npm test && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.7",
    "rehype-external-links": "^3.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript-eslint": "^8.71.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.6"
    }
  }
}
